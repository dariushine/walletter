# ===== Walletter API — Configuración =====
# Copia este archivo a `.env` y ajusta los valores.

# Puerto de la API (default 3002)
PORT=3002

# Autenticación básica. Si dejas AUTH_USERNAME/AUTH_PASSWORD vacíos, la auth
# queda DESHABILITADA (todos los endpoints públicos). En producción configura ambos.
AUTH_USERNAME=
AUTH_PASSWORD=

# JWT_SECRET es OBLIGATORIO si la auth está habilitada.
# Mínimo 32 caracteres (256 bits).
JWT_SECRET=

# String de conexión a la base de datos (SQLite por defecto).
# Para PostgreSQL/MySQL cambia el provider en
# Walletter.Infrastructure/DependencyInjection.cs y este valor.
CONNECTIONSTRINGS__WALLETTERDB=Data Source=data/walletter.db
